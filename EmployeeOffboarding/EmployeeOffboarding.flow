            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:SubProcess"
      },
      "outputDefinition": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "drillable": true
    },
    {
      "nodeType": "core.datafabric.update",
      "version": "1.3",
      "category": "data",
      "description": "Update an entity record in Data Fabric",
      "tags": [
        "datafabric",
        "entity",
        "data",
        "update",
        "write"
      ],
      "sortOrder": 36,
      "display": {
        "label": "Update entity record",
        "icon": "layers-arrow-up-right"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:Task",
        "debug": {
          "runtime": "bpmnEngine"
        }
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "entityConfig": {
            "type": "object",
            "properties": {
              "entityName": {
                "type": "string",
                "minLength": 1,
                "errorMessage": "An entity must be selected"
              },
              "recordId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "jsExpression"
                      },
                      "expression": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "type",
                      "expression"
                    ]
                  }
                ]
              },
              "readEntityNodeId": {
                "type": "string"
              },
              "fieldUpdates": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "field"
                  ]
                },
                "errorMessage": "Select a field to update"
              }
            },
            "required": [
              "entityName",
              "fieldUpdates"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "recordSource": {
                      "const": "byId"
                    }
                  },
                  "required": [
                    "recordSource"
                  ]
                },
                "then": {
                  "required": [
                    "recordId"
                  ],
                  "properties": {
                    "recordId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "jsExpression"
                            },
                            "expression": {
                              "type": "string",
                              "pattern": "\\S"
                            }
                          },
                          "required": [
                            "type",
                            "expression"
                          ]
                        }
                      ]
                    }
                  },
                  "errorMessage": "A record ID is required"
                }
              },
              {
                "if": {
                  "properties": {
                    "recordSource": {
                      "const": "fromRead"
                    }
                  },
                  "required": [
                    "recordSource"
                  ]
                },
                "then": {
                  "required": [
                    "readEntityNodeId"
                  ],
                  "properties": {
                    "readEntityNodeId": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "errorMessage": "Select a Query entity records node"
                }
              }
            ],
            "errorMessage": {
              "required": {
                "entityName": "An entity must be selected",
                "fieldUpdates": "Select a field to update"
              }
            }
          }
        },
        "required": [
          "entityConfig"
        ]
      },
      "inputDefaults": {
        "entityConfig": {}
      },
      "outputDefinition": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record after the update",
          "source": "=response",
          "var": "output"
        }
      },
      "form": {
        "id": "update-entity-properties",
        "title": "Update entity record configuration",
        "sections": [
          {
            "id": "entity-config",
            "title": "Entity configuration",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.entityConfig",
                "type": "custom",
                "component": "update-entity-config",
                "label": ""
              }
            ]
          }
        ]
      }
    },
