        {
          "id": "roleLoop",
          "type": "core.logic.loop",
          "typeVersion": "2.4",
          "display": {
            "label": "For each directory role"
          },
          "inputs": {
            "collection": "=js:$vars.reReadRoles1.output || []",
            "parallel": false
          }
        },
        {
          "id": "recordRoleRemoved",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Record removed role"
          },
          "inputs": {
            "script": "return { name: $vars.roleLoop.currentItem.displayName };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
