                            "type",
                            "expression"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "value"
                  ]
                },
                "errorMessage": "Set a value for at least one field"
              }
            },
            "required": [
              "entityName",
              "fieldValues"
            ],
            "errorMessage": {
              "required": {
                "entityName": "An entity must be selected",
                "fieldValues": "Set a value for at least one field"
              }
            }
          }
        },
        "required": [
          "entityConfig"
        ]
      },
