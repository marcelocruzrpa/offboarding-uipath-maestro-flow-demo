            "script": "const e = $vars.removeLicense1.error;\nreturn { failure: 'Could not remove license ' + $vars.licenseLoop.currentItem.name + ': ' + ((e && (e.message || e.detail)) || 'unknown error') };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          },
          "parentId": "licenseLoop"
        },
