  "subflows": {
    "revokeAccess": {
      "nodes": [
        {
          "id": "groupsReadFailed",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Groups not readable"
          },
          "inputs": {
            "script": "const e = $vars.reReadGroups1.error;\nreturn { failure: 'Could not read group memberships, so no groups were removed: ' + ((e && (e.message || e.detail)) || 'unknown error') };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          }
        },
        {
          "id": "rolesReadFailed",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Roles not readable"
          },
          "inputs": {
            "script": "const e = $vars.reReadRoles1.error;\nreturn { failure: 'Could not read directory roles, so no roles were removed: ' + ((e && (e.message || e.detail)) || 'unknown error') };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          }
        },
        {
          "id": "licensesReadFailed",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Licenses not readable"
          },
          "inputs": {
            "script": "const e = $vars.readLicenseAssignments1.error;\nreturn { failure: 'Could not read license assignments, so no licenses were removed: ' + ((e && (e.message || e.detail)) || 'unknown error') };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          }
        },
        {
          "id": "raStart",
          "type": "core.trigger.manual",
          "typeVersion": "1.0",
          "display": {
            "label": "Start"
          },
          "inputs": {
            "entryPointId": "5b0e6c2a-8f3d-4c1e-9a7b-2d4f6e8a1c3b",
            "isDefaultEntryPoint": true
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "Data passed when manually triggering the workflow.",
              "source": "null",
              "var": "output"
            }
          }
        },
        {
          "id": "prepareGroupRemoval",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Pick groups to remove"
          },
          "inputs": {
            "script": "const groups = ($vars.reReadGroups1.output || []).filter(g => !g.roleTemplateId);\nconst isDynamic = g => (g.groupTypes || []).indexOf('DynamicMembership') >= 0;\nconst removable = groups.filter(g => !isDynamic(g)).map(g => ({ id: g.id, name: g.displayName }));\nconst skipped = groups.filter(isDynamic).map(g => 'Group ' + g.displayName + ' uses dynamic membership: update its membership rule to exclude the user');\nreturn { removable: removable, skipped: skipped };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          }
        },
        {
          "id": "groupLoop",
          "type": "core.logic.loop",
          "typeVersion": "2.4",
          "display": {
            "label": "For each group"
          },
          "inputs": {
            "collection": "=js:$vars.prepareGroupRemoval.output.removable",
            "parallel": false
          }
        },
        {
          "id": "recordGroupRemoved",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Record removed group"
          },
          "inputs": {
            "script": "return { name: $vars.groupLoop.currentItem.name };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          },
          "parentId": "groupLoop"
        },
        {
          "id": "recordGroupFailure",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Record group failure"
          },
          "inputs": {
            "script": "const e = $vars.removeFromGroup1.error;\nreturn { failure: 'Could not remove from group ' + $vars.groupLoop.currentItem.name + ': ' + ((e && (e.message || e.detail)) || 'unknown error') };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
