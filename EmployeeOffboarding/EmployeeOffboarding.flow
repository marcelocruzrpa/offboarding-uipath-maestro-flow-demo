    {
      "id": "criticalFailure",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Describe failure",
        "icon": "code"
      },
      "inputs": {
        "script": "const ra = $vars.revokeAccess;\nconst it = $vars.itTasksAndHandover;\nconst raErr = ra && ra.error;\nconst itErr = it && it.error;\nconst err = raErr || itErr;\nconst stage = raErr ? 'Revoke access' : 'IT tasks and handover';\nconst detail = (err && (err.message || err.detail)) || 'unknown error';\nconst headline = raErr ? 'Access revocation failed — manual action required.' : 'IT tasks and handover failed — manual action required.';\nreturn { stage: stage, detail: detail, text: headline + ' Stage: ' + stage + '. Error: ' + detail };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
