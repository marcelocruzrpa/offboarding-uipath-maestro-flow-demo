    "itTasksAndHandover": {
      "nodes": [
        {
          "id": "issueSearchFailed",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Open issues not searchable"
          },
          "inputs": {
            "script": "const e = $vars.searchLeaverOpenIssues1.error;\nreturn { failure: 'Could not search the open issues assigned to the leaver, so none were reassigned: ' + ((e && (e.message || e.detail)) || 'unknown error') };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          }
        },
        {
          "id": "itStart",
          "type": "core.trigger.manual",
          "typeVersion": "1.0",
          "display": {
            "label": "Start"
          },
          "inputs": {
            "entryPointId": "a7c3e1f5-2b4d-4e6a-8c9f-1e3a5b7d9f20",
            "isDefaultEntryPoint": true
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "Data passed when manually triggering the workflow.",
              "source": "null",
              "var": "output"
            }
          }
        },
        {
          "id": "assetLoop",
          "type": "core.logic.loop",
          "typeVersion": "2.4",
          "display": {
            "label": "For each asset"
          },
          "inputs": {
            "collection": "=js:$vars.itStart.output.assets || []",
            "parallel": false
          }
        },
        {
          "id": "markAssetReturnRequested",
          "type": "core.datafabric.update",
          "typeVersion": "1.3",
          "display": {
            "label": "Mark asset return requested"
          },
          "inputs": {
            "entityConfig": {
              "entityName": "OffbAsset",
              "recordSource": "byId",
              "recordId": "=js:$vars.assetLoop.currentItem.Id",
              "fieldUpdates": [
                {
                  "field": "Status",
                  "value": "Return requested"
                }
              ]
            }
          },
          "parentId": "assetLoop"
        },
        {
          "id": "recordSubtaskCreated",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Record sub-task"
          },
          "inputs": {
            "script": "const a = $vars.assetLoop.currentItem;\nreturn { entry: ($vars.createReturnSubtask1.output.key || '?') + ' (' + a.Type + ' ' + a.AssetTag + ')' };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          },
          "parentId": "assetLoop"
        },
        {
          "id": "recordSubtaskFailure",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Record sub-task failure"
          },
          "inputs": {
            "script": "const a = $vars.assetLoop.currentItem;\nconst e = $vars.createReturnSubtask1.error;\nreturn { failure: 'Could not create the return sub-task for ' + a.Type + ' ' + a.AssetTag + ': ' + ((e && (e.message || e.detail)) || 'unknown error') };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          },
          "parentId": "assetLoop"
        },
        {
          "id": "resolveJiraUsers",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Match Jira accounts"
          },
          "inputs": {
            "script": "const pick = (list, email) => {\n  const arr = list || [];\n  const target = String(email || '').toLowerCase();\n  const exact = arr.find(u => u.emailAddress && u.emailAddress.toLowerCase() === target);\n  return exact || (arr.length === 1 ? arr[0] : null);\n};\nconst start = $vars.itStart.output;\nconst handover = pick($vars.findHandoverUser1.output, start.handoverEmail);\nconst leaver = pick($vars.findLeaverInJira1.output, start.upn);\nconst failures = [];\nif (!leaver) failures.push('No Jira account found for ' + start.upn + ': open issues were not reassigned');\nif (!handover) failures.push('No Jira account found for the handover person ' + start.handoverEmail + ': open issues were not reassigned');\nreturn {\n  canReassign: !!(leaver && handover),\n  leaverAccountId: leaver ? leaver.accountId : '',\n  leaverName: leaver ? leaver.displayName : start.upn,\n  handoverAccountId: handover ? handover.accountId : '',\n  handoverName: handover ? handover.displayName : '',\n  jql: leaver ? 'assignee = \"' + leaver.accountId + '\" AND statusCategory != Done ORDER BY key ASC' : '',\n  failures: failures\n};"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          }
        },
        {
          "id": "canReassign",
          "type": "core.logic.decision",
          "typeVersion": "1.3",
          "display": {
            "label": "Both Jira accounts found?"
          },
          "inputs": {
            "expression": "$vars.resolveJiraUsers.output.canReassign === true",
            "trueLabel": "Yes",
            "falseLabel": "No"
          }
        },
        {
          "id": "reassignLoop",
          "type": "core.logic.loop",
          "typeVersion": "2.4",
          "display": {
            "label": "For each open issue"
          },
          "inputs": {
            "collection": "=js:$vars.searchLeaverOpenIssues1.output || []",
            "parallel": false
          }
        },
        {
          "id": "recordReassigned",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Record reassigned issue"
          },
          "inputs": {
            "script": "return { key: $vars.reassignLoop.currentItem.key };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          },
          "parentId": "reassignLoop"
        },
        {
          "id": "recordReassignFailure",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Record reassignment failure"
          },
          "inputs": {
            "script": "const e = $vars.reassignIssue1.error;\nreturn { failure: 'Could not reassign ' + $vars.reassignLoop.currentItem.key + ': ' + ((e && (e.message || e.detail)) || 'unknown error') };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          },
          "parentId": "reassignLoop"
        },
        {
          "id": "itEnd",
          "type": "core.control.end",
          "typeVersion": "1.0",
          "display": {
            "label": "IT tasks done"
          },
          "inputs": {},
          "outputs": {
            "subtasks": {
              "source": "=js:$vars.subtasksLog"
            },
            "reassigned": {
              "source": "=js:$vars.reassignedLog"
            },
            "failures": {
              "source": "=js:$vars.failureLog"
            },
            "subtasksLog": {
              "source": "=js:$vars.subtasksLog"
            },
            "reassignedLog": {
              "source": "=js:$vars.reassignedLog"
            },
            "failureLog": {
              "source": "=js:$vars.failureLog"
            }
          }
        },
        {
          "id": "createReturnSubtask1",
          "type": "uipath.connector.uipath-atlassian-jira.create-issue",
          "typeVersion": "1.0.0",
          "display": {
            "label": "Create return subtask"
          },
          "inputs": {
            "detail": {
              "connector": "uipath-atlassian-jira",
              "connectionId": "3d35fe25-da38-4eec-9ec9-5245c7cf72e3",
              "connectionResourceId": "3d35fe25-da38-4eec-9ec9-5245c7cf72e3",
              "connectionFolderKey": "fa6e8c3a-a09b-423b-8d6d-40335ce26e70",
              "method": "POST",
              "endpoint": "/curated_create_issue",
              "bodyParameters": {
                "fields.project.key": "KAN",
                "fields.issuetype.id": "10003",
                "fields.parent.key": "=js:$vars.itStart.output.jiraKey",
                "fields.summary": "=js:'Return ' + $vars.assetLoop.currentItem.Type + ' ' + $vars.assetLoop.currentItem.AssetTag + ' (' + $vars.assetLoop.currentItem.Model + ')'",
                "fields.reporter.id": "=js:$vars.itStart.output.reporterAccountId"
              },
              "uiPathActivityTypeId": "f90a75ba-d728-34b6-a84a-fb1f995b784b",
              "errorState": {
                "issues": []
              },
              "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.13.3\",\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"fields_sub_project_sub_key\",\"KAN\"],[\"fields_sub_issuetype_sub_id\",\"10003\"]]},\"instanceParameters\":{\"connectorKey\":\"uipath-atlassian-jira\",\"objectName\":\"curated_create_issue\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"curated_create_issue\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/curated_create_issue\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_curated_create_issue\"}}"
            },
            "errorHandlingEnabled": true
          },
          "parentId": "assetLoop"
        },
        {
          "id": "findHandoverUser1",
          "type": "uipath.connector.uipath-atlassian-jira.find-user-by-email-address-or-display-name",
          "typeVersion": "1.0.0",
          "display": {
            "label": "Find handover user"
          },
          "inputs": {
            "detail": {
              "connector": "uipath-atlassian-jira",
              "connectionId": "3d35fe25-da38-4eec-9ec9-5245c7cf72e3",
              "connectionResourceId": "3d35fe25-da38-4eec-9ec9-5245c7cf72e3",
              "connectionFolderKey": "fa6e8c3a-a09b-423b-8d6d-40335ce26e70",
              "method": "GET",
              "endpoint": "/search_user",
              "queryParameters": {
                "username": "=js:$vars.itStart.output.handoverEmail"
              },
              "uiPathActivityTypeId": "8ec36fa7-65f6-356a-9c22-888d69e58f7c",
              "errorState": {
