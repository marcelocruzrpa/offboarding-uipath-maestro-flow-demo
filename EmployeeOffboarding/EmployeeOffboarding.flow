    {
      "id": "badInputReason",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Explain bad input",
        "icon": "code"
      },
      "inputs": {
        "script": "const p = $vars.parseRequest.output || {};\nlet reason = p.reason;\nif (!reason) {\n  const account = $vars.getLeaverAccount1;\n  const err = account && account.error;\n  if (err) {\n    reason = err.status === 404 ? 'no Entra ID account found for ' + p.upn : 'the Entra ID lookup for ' + p.upn + ' failed (' + (err.message || err.detail || 'unknown error') + ')';\n  } else {\n    reason = 'no HR record (OffbEmployee) found for ' + p.upn;\n  }\n}\nreturn { reason: reason, jiraKey: p.jiraKey, upn: p.upn || '' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
