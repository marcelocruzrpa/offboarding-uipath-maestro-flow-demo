  "variables": {
    "globals": [
      {
        "id": "demoMode",
        "direction": "inout",
        "type": "boolean",
        "defaultValue": true,
        "description": "Demo mode: cut access demoDelayMinutes after approval instead of at 18:00 on the last working day"
      },
      {
        "id": "demoDelayMinutes",
        "direction": "inout",
        "type": "number",
        "defaultValue": 2,
        "description": "Minutes between approval and access cutover when demoMode is true"
      },
      {
        "id": "cutoverUtcOffset",
        "direction": "inout",
        "type": "string",
        "defaultValue": "+01:00",
        "description": "ISO UTC offset for the 18:00 cutover when demoMode is false (for example +01:00)"
