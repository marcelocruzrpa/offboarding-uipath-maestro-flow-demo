        "exclude": [
          "api-function"
        ]
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "entityConfig": {
            "type": "object",
            "properties": {
              "entityName": {
                "type": "string",
                "minLength": 1,
                "errorMessage": "An entity must be selected"
              },
              "fieldValues": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        {
                          "type": "object",
