              "var": "error"
            }
          },
          "parentId": "roleLoop"
        },
        {
          "id": "prepareLicenseRemoval",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Pick direct licenses"
          },
          "inputs": {
            "script": "const states = (($vars.readLicenseAssignments1.output || {}).body || {}).licenseAssignmentStates || [];\nconst details = (($vars.readLicenseNames1.output || {}).body || {}).value || [];\nconst nameOf = sku => { const d = details.find(x => x.skuId === sku); return d ? d.skuPartNumber : sku; };\nconst groupPlan = $vars.prepareGroupRemoval && $vars.prepareGroupRemoval.output;\nconst planned = (groupPlan && groupPlan.removable) || [];\nconst removedNames = $vars.removedGroupsLog || [];\nconst removedGroupIds = planned.filter(g => removedNames.indexOf(g.name) >= 0).map(g => g.id);\nconst direct = [];\nconst stillInherited = [];\nstates.forEach(s => {\n  if (!s.assignedByGroup) {\n    if (direct.indexOf(s.skuId) < 0) direct.push(s.skuId);\n  } else if (removedGroupIds.indexOf(s.assignedByGroup) < 0 && stillInherited.indexOf(s.skuId) < 0) {\n    stillInherited.push(s.skuId);\n  }\n});\nconst toRemove = direct.map(sku => ({ skuId: sku, name: nameOf(sku) }));\nconst skipped = stillInherited.filter(sku => direct.indexOf(sku) < 0).map(sku => 'License ' + nameOf(sku) + ' comes from a group the user is still in: remove it at group level');\nreturn { toRemove: toRemove, skipped: skipped };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=Error",
              "var": "error"
            }
          }
        },
        {
          "id": "licenseLoop",
          "type": "core.logic.loop",
          "typeVersion": "2.4",
          "display": {
            "label": "For each direct license"
          },
          "inputs": {
            "collection": "=js:$vars.prepareLicenseRemoval.output.toRemove",
            "parallel": false
          }
        },
        {
          "id": "recordLicenseRemoved",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Record removed license"
          },
          "inputs": {
            "script": "return { name: $vars.licenseLoop.currentItem.name };"
