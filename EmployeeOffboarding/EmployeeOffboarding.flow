{
  "id": "097cdcfb-3559-4870-a0cf-b82f59202a05",
  "version": "1.9",
  "name": "EmployeeOffboarding",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "parseRequest",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Parse offboarding request",
        "icon": "code"
      },
      "inputs": {
        "script": "const issue = $vars.offboardingIssueCreated1.output || {};\nconst f = issue.fields || {};\nconst summary = String(f.summary || '').trim();\nconst match = /^offboard:\\s*([^\\s@]+@[^\\s@]+)\\s*$/i.exec(summary);\nconst dueDate = String(f.duedate || '');\nlet reason = '';\nif (!match) {\n  reason = 'the summary must look like Offboard: <UPN> (found: ' + summary + ')';\n} else if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(dueDate)) {\n  reason = 'the Due date (last working day) is empty';\n} else if ($vars.demoMode !== true && !/^[+-]\\d{2}:\\d{2}$/.test(String($vars.cutoverUtcOffset))) {\n  reason = 'the flow setting cutoverUtcOffset (' + $vars.cutoverUtcOffset + ') is not a UTC offset like +01:00';\n}\nreturn {\n  valid: reason === '',\n  reason: reason,\n  jiraKey: issue.key || '',\n  upn: match ? match[1].toLowerCase() : '',\n  dueDate: dueDate,\n  reporterAccountId: (f.reporter && f.reporter.accountId) || ''\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "isRequestValid",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Request valid?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "expression": "$vars.parseRequest.output.valid === true",
        "trueLabel": "Valid",
        "falseLabel": "Invalid"
      }
    },
    {
      "id": "readHrRecord",
      "type": "core.datafabric.read",
      "typeVersion": "1.4",
      "display": {
        "label": "Read HR record",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "OffbEmployee",
          "resultMode": "single",
          "_filters": {
            "logicalOperator": "AND",
            "rows": [
              {
                "field": "UPN",
                "operator": "=",
                "value": "=js:$vars.parseRequest.output.upn"
              }
            ],
            "groups": []
          }
        }
      },
      "outputs": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record queried by this node, or the matching records under \"results\"",
          "source": "=response",
          "var": "output"
        }
      }
    },
    {
      "id": "hrRecordFound",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "HR record found?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "expression": "!!($vars.readHrRecord.output && $vars.readHrRecord.output.Id)",
        "trueLabel": "Found",
        "falseLabel": "Missing"
      }
    },
    {
      "id": "readAssignedAssets",
      "type": "core.datafabric.read",
      "typeVersion": "1.4",
      "display": {
        "label": "Read assigned assets",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "OffbAsset",
          "resultMode": "multiple",
          "_recordLimit": 50,
          "_skip": 0,
          "_sort": {
            "field": "AssetTag",
            "direction": "asc"
          },
          "_filters": {
            "logicalOperator": "AND",
            "rows": [
              {
                "field": "AssignedToUPN",
                "operator": "=",
                "value": "=js:$vars.parseRequest.output.upn"
              }
            ],
            "groups": []
          }
        }
      },
      "outputs": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record queried by this node, or the matching records under \"results\"",
          "source": "=response",
          "var": "output"
        }
      }
    },
    {
      "id": "computeCutover",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Plan cutover time",
        "icon": "code"
      },
      "inputs": {
        "script": "const demo = $vars.demoMode === true;\nconst plannedAt = demo ? '' : new Date($vars.parseRequest.output.dueDate + 'T18:00:00' + $vars.cutoverUtcOffset).toISOString();\nreturn {\n  plannedAt: plannedAt,\n  display: demo ? $vars.demoDelayMinutes + ' minutes after approval (demo mode)' : plannedAt.substring(0, 16).replace('T', ' ') + ' UTC (last working day 18:00 ' + $vars.cutoverUtcOffset + ')'\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "prepareApprovalForm",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Prepare approval summary",
        "icon": "code"
      },
      "inputs": {
        "script": "const user = $vars.getLeaverAccount1.output;\nconst hr = $vars.readHrRecord.output || {};\nconst manager = $vars.getManager1.output;\nconst noManager = $vars.noManagerSet && $vars.noManagerSet.output;\nconst managerNote = (noManager && noManager.note) || '(no manager set in Entra ID)';\nconst groups = ($vars.listCurrentGroups1.output || []).filter(g => !g.roleTemplateId);\nconst roles = $vars.listDirectoryRoles1.output || [];\nconst assets = ($vars.readAssignedAssets.output || {}).results || [];\nconst isDynamic = g => (g.groupTypes || []).indexOf('DynamicMembership') >= 0;\nreturn {\n  fullName: hr.FullName || user.displayName || '',\n  department: hr.Department || user.department || '',\n  managerName: (manager && manager.displayName) || managerNote,\n  lastDay: $vars.parseRequest.output.dueDate,\n  cutoverAt: $vars.computeCutover.output.display,\n  groupsToRemove: groups.map(g => isDynamic(g) ? g.displayName + ' (dynamic, needs a rule change)' : g.displayName).join(', ') || 'None',\n  rolesToRemove: roles.map(r => r.displayName).join(', ') || 'None',\n  assetsToReturn: assets.map(a => a.Type + ' ' + a.AssetTag + ' (' + a.Model + ')').join(', ') || 'None',\n  handoverEmail: $vars.defaultHandoverEmail\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerApproval",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.6",
      "display": {
        "label": "Manager approval",
        "icon": "users"
      },
      "inputs": {
        "type": "quick",
        "title": "Approve employee offboarding",
        "priority": "Medium",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "staticEmail",
            "value": "approver@example.com"
          }
        },
        "schema": {
          "schemaId": "c4e8a2f6-1d3b-4f5a-9e7c-3b5d7f9a1c2e",
          "fields": [
            {
              "id": "fullname",
              "label": "Employee",
              "type": "string",
              "direction": "input",
              "binding": "vars.prepareApprovalForm.output.fullName"
            },
            {
              "id": "department",
              "label": "Department",
              "type": "string",
              "direction": "input",
              "binding": "vars.prepareApprovalForm.output.department"
            },
            {
              "id": "manager",
              "label": "Manager (Entra ID)",
              "type": "string",
              "direction": "input",
              "binding": "vars.prepareApprovalForm.output.managerName"
            },
            {
              "id": "lastday",
              "label": "Last working day",
              "type": "string",
              "direction": "input",
              "binding": "vars.prepareApprovalForm.output.lastDay"
            },
            {
              "id": "cutover",
              "label": "Access cutover",
              "type": "string",
              "direction": "input",
              "binding": "vars.prepareApprovalForm.output.cutoverAt"
            },
            {
              "id": "groups",
              "label": "Groups to remove",
              "type": "string",
              "direction": "input",
              "binding": "vars.prepareApprovalForm.output.groupsToRemove"
            },
            {
              "id": "roles",
              "label": "Directory roles to remove",
              "type": "string",
              "direction": "input",
              "binding": "vars.prepareApprovalForm.output.rolesToRemove"
            },
            {
              "id": "assets",
              "label": "Assets to return",
              "type": "string",
              "direction": "input",
              "binding": "vars.prepareApprovalForm.output.assetsToReturn"
            },
            {
              "id": "handoveremail",
              "label": "Hand over open Jira issues to (email)",
              "type": "string",
              "direction": "inOut",
              "binding": "vars.prepareApprovalForm.output.handoverEmail",
              "variable": "vars.handoverEmail"
            },
            {
              "id": "comment",
              "label": "Comment (optional)",
              "type": "string",
              "direction": "output",
              "variable": "vars.approverComment"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "handoveremail": {
              "type": "string"
            },
            "comment": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "noManagerSet",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "No manager set",
        "icon": "code"
      },
      "inputs": {
        "script": "const e = $vars.getManager1.error;\nreturn { note: (e && e.status === 404) ? '(no manager set in Entra ID)' : '(manager lookup failed: ' + ((e && (e.message || e.detail)) || 'unknown error') + ')' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "scheduleCutover",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Schedule cutover",
        "icon": "code"
      },
      "inputs": {
        "script": "const demo = $vars.demoMode === true;\nconst at = demo ? new Date(Date.now() + Number($vars.demoDelayMinutes) * 60000) : new Date($vars.computeCutover.output.plannedAt);\nconst iso = at.toISOString();\nreturn {\n  cutoverAt: iso,\n  cutoverDisplay: iso.substring(0, 16).replace('T', ' ') + ' UTC',\n  mode: demo ? 'demo mode, ' + $vars.demoDelayMinutes + ' min after approval' : 'last working day 18:00 ' + $vars.cutoverUtcOffset\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "isApproved",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Approved?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "expression": "$vars.managerApproval.status === 'Approve'",
        "trueLabel": "Approve",
        "falseLabel": "Reject"
      }
    },
    {
      "id": "auditRejected",
      "type": "core.datafabric.create",
      "typeVersion": "1.3",
      "display": {
        "label": "Audit: rejected",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "OffbAuditLog",
          "fieldValues": [
            {
              "field": "JiraKey",
              "value": "=js:$vars.parseRequest.output.jiraKey"
            },
            {
              "field": "UPN",
              "value": "=js:$vars.parseRequest.output.upn"
            },
            {
              "field": "Stage",
              "value": "Manager approval"
            },
            {
              "field": "Outcome",
              "value": "Rejected"
            },
            {
              "field": "Details",
              "value": "=js:$vars.managerApproval.output.comment || 'Rejected without a comment'"
            },
            {
              "field": "LoggedAt",
              "value": "=js:new Date().toISOString()"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record created by this node",
          "source": "=response",
          "var": "output"
        }
      }
    },
    {
      "id": "endRejected",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Cancelled by approver",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "demoMode": {
          "source": "=js:$vars.demoMode",
          "type": "string"
        },
        "demoDelayMinutes": {
          "source": "=js:$vars.demoDelayMinutes",
          "type": "string"
        },
        "cutoverUtcOffset": {
          "source": "=js:$vars.cutoverUtcOffset",
          "type": "string"
        },
        "defaultHandoverEmail": {
          "source": "=js:$vars.defaultHandoverEmail",
          "type": "string"
        }
      }
    },
    {
      "id": "auditApproved",
      "type": "core.datafabric.create",
      "typeVersion": "1.3",
      "display": {
        "label": "Audit: approved",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "OffbAuditLog",
          "fieldValues": [
            {
              "field": "JiraKey",
              "value": "=js:$vars.parseRequest.output.jiraKey"
            },
            {
              "field": "UPN",
              "value": "=js:$vars.parseRequest.output.upn"
            },
            {
              "field": "Stage",
              "value": "Manager approval"
            },
            {
              "field": "Outcome",
              "value": "Success"
            },
            {
              "field": "Details",
              "value": "=js:'Approved. Cutover at ' + $vars.scheduleCutover.output.cutoverAt +'. Handover to ' + ($vars.managerApproval.output.handoveremail || $vars.defaultHandoverEmail) + ($vars.managerApproval.output.comment ? '. Comment: ' + $vars.managerApproval.output.comment : '')"
            },
            {
              "field": "LoggedAt",
              "value": "=js:new Date().toISOString()"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record created by this node",
          "source": "=response",
          "var": "output"
        }
      }
    },
    {
      "id": "waitForCutover",
      "type": "core.logic.delay",
      "typeVersion": "1.0",
      "display": {
        "label": "Wait for cutover",
        "icon": "timer"
      },
      "inputs": {
        "timerType": "timeDate",
        "timerPreset": "custom",
        "timerDate": "=js:$vars.scheduleCutover.output.cutoverAt"
      }
    },
    {
      "id": "revokeAccess",
      "type": "core.subflow",
      "typeVersion": "1.0",
      "display": {
        "label": "Revoke access",
        "icon": "layers"
      },
      "inputs": {
        "upn": "=js:$vars.parseRequest.output.upn",
        "userId": "=js:$vars.getLeaverAccount1.output.id",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the subflow fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string",
                "descriptionKey": "subflowInterface_errorCode_description"
              },
              "message": {
                "type": "string",
                "description": "High-level error message",
                "descriptionKey": "subflowInterface_errorMessage_description"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description",
                "descriptionKey": "subflowInterface_errorDetail_description"
              },
              "category": {
                "type": "string",
                "description": "Error category",
                "descriptionKey": "subflowInterface_errorCategory_description"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code",
                "descriptionKey": "subflowInterface_errorStatus_description"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "auditAccessRevoked",
      "type": "core.datafabric.create",
      "typeVersion": "1.3",
      "display": {
        "label": "Audit: access revoked",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "OffbAuditLog",
          "fieldValues": [
            {
              "field": "JiraKey",
              "value": "=js:$vars.parseRequest.output.jiraKey"
            },
            {
              "field": "UPN",
              "value": "=js:$vars.parseRequest.output.upn"
            },
            {
              "field": "Stage",
              "value": "Revoke access"
            },
            {
              "field": "Outcome",
              "value": "=js:($vars.revokeAccess.output.failures || []).length > 0 ? 'Warning' : 'Success'"
            },
            {
              "field": "Details",
              "value": "=js:('Account disabled. Groups removed: ' + (($vars.revokeAccess.output.removedGroups || []).join(', ') || 'none') + '. Roles removed: ' + (($vars.revokeAccess.output.removedRoles || []).join(', ') || 'none') + '. Licenses removed: ' + (($vars.revokeAccess.output.removedLicenses || []).join(', ') || 'none') + (($vars.revokeAccess.output.failures || []).length ? '. Needs attention: ' + $vars.revokeAccess.output.failures.join('; ') : '')).substring(0, 3990)"
            },
            {
              "field": "LoggedAt",
              "value": "=js:new Date().toISOString()"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record created by this node",
          "source": "=response",
          "var": "output"
        }
      }
    },
    {
      "id": "itTasksAndHandover",
      "type": "core.subflow",
      "typeVersion": "1.0",
      "display": {
        "label": "IT tasks and handover",
        "icon": "layers"
      },
      "inputs": {
        "jiraKey": "=js:$vars.parseRequest.output.jiraKey",
        "upn": "=js:$vars.parseRequest.output.upn",
        "assets": "=js:($vars.readAssignedAssets.output || {}).results || []",
        "handoverEmail": "=js:$vars.managerApproval.output.handoveremail || $vars.defaultHandoverEmail",
        "reporterAccountId": "=js:$vars.parseRequest.output.reporterAccountId",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the subflow fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string",
                "descriptionKey": "subflowInterface_errorCode_description"
              },
              "message": {
                "type": "string",
                "description": "High-level error message",
                "descriptionKey": "subflowInterface_errorMessage_description"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description",
                "descriptionKey": "subflowInterface_errorDetail_description"
              },
              "category": {
                "type": "string",
                "description": "Error category",
                "descriptionKey": "subflowInterface_errorCategory_description"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code",
                "descriptionKey": "subflowInterface_errorStatus_description"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "auditItTasks",
      "type": "core.datafabric.create",
      "typeVersion": "1.3",
      "display": {
        "label": "Audit: IT tasks",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "OffbAuditLog",
          "fieldValues": [
            {
              "field": "JiraKey",
              "value": "=js:$vars.parseRequest.output.jiraKey"
            },
            {
              "field": "UPN",
              "value": "=js:$vars.parseRequest.output.upn"
            },
            {
              "field": "Stage",
              "value": "IT tasks and handover"
            },
            {
              "field": "Outcome",
              "value": "=js:($vars.itTasksAndHandover.output.failures || []).length > 0 ? 'Warning' : 'Success'"
            },
            {
              "field": "Details",
              "value": "=js:('Asset return sub-tasks: ' + (($vars.itTasksAndHandover.output.subtasks || []).join(', ') || 'none') + '. Issues reassigned: ' + (($vars.itTasksAndHandover.output.reassigned || []).join(', ') || 'none') + (($vars.itTasksAndHandover.output.failures || []).length ? '. Needs attention: ' + $vars.itTasksAndHandover.output.failures.join('; ') : '')).substring(0, 3990)"
            },
            {
              "field": "LoggedAt",
              "value": "=js:new Date().toISOString()"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record created by this node",
          "source": "=response",
          "var": "output"
        }
      }
    },
    {
      "id": "markEmployeeOffboarded",
      "type": "core.datafabric.update",
      "typeVersion": "1.3",
      "display": {
        "label": "Mark employee offboarded",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "OffbEmployee",
          "recordSource": "fromRead",
          "readEntityNodeId": "readHrRecord",
          "fieldUpdates": [
            {
              "field": "EmploymentStatus",
              "value": "Offboarded"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record after the update",
          "source": "=response",
          "var": "output"
        }
      }
    },
    {
      "id": "buildSummary",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Build close-out summary",
        "icon": "code"
      },
      "inputs": {
        "script": "const ra = $vars.revokeAccess.output || {};\nconst it = $vars.itTasksAndHandover.output || {};\nconst p = $vars.parseRequest.output;\nconst hr = $vars.readHrRecord.output || {};\nconst handover = $vars.managerApproval.output.handoveremail || $vars.defaultHandoverEmail;\nconst list = a => (a && a.length) ? a.join(', ') : 'None';\nconst failures = (ra.failures || []).concat(it.failures || []);\nconst rows = [\n  ['Account disabled', ra.disabled ? 'Yes' : 'No'],\n  ['Groups removed', list(ra.removedGroups)],\n  ['Directory roles removed', list(ra.removedRoles)],\n  ['Licenses removed', list(ra.removedLicenses)],\n  ['Asset return sub-tasks', list(it.subtasks)],\n  ['Open issues reassigned to ' + handover, list(it.reassigned)],\n  ['HR record', 'EmploymentStatus set to Offboarded']\n];\nlet text = 'h3. Offboarding complete: ' + (hr.FullName || p.upn) + ' (' + p.upn + ')\\n||Action||Result||\\n';\ntext += rows.map(r => '|' + r[0] + '|' + r[1] + '|').join('\\n');\nif (failures.length) {\n  text += '\\n\\nh4. Needs attention\\n' + failures.map(f => '* ' + f).join('\\n');\n  text += '\\n\\nThis issue stays In Progress until the items above are resolved.';\n}\nreturn {\n  text: text,\n  failureCount: failures.length,\n  failures: failures,\n  outcome: failures.length ? 'Warning' : 'Success'\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "auditCloseOut",
      "type": "core.datafabric.create",
      "typeVersion": "1.3",
      "display": {
        "label": "Audit: close-out",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "OffbAuditLog",
          "fieldValues": [
            {
              "field": "JiraKey",
              "value": "=js:$vars.parseRequest.output.jiraKey"
            },
            {
              "field": "UPN",
              "value": "=js:$vars.parseRequest.output.upn"
            },
            {
              "field": "Stage",
              "value": "Close-out"
            },
            {
              "field": "Outcome",
              "value": "=js:$vars.buildSummary.output.outcome"
            },
            {
              "field": "Details",
              "value": "=js:($vars.buildSummary.output.failureCount > 0 ? 'Needs attention: ' + $vars.buildSummary.output.failures.join('; ') : 'All steps completed. HR record set to Offboarded.').substring(0, 3990)"
            },
            {
              "field": "LoggedAt",
              "value": "=js:new Date().toISOString()"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record created by this node",
          "source": "=response",
          "var": "output"
        }
      }
    },
    {
      "id": "hasFailures",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Needs attention?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "expression": "$vars.buildSummary.output.failureCount > 0",
        "trueLabel": "Yes",
        "falseLabel": "No"
      }
    },
