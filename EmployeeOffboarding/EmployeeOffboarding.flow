        },
        {
          "id": "recordRoleFailure",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Record role failure"
          },
          "inputs": {
            "script": "const e = $vars.removeFromRole1.error;\nreturn { failure: 'Could not remove directory role ' + $vars.roleLoop.currentItem.displayName + ': ' + ((e && (e.message || e.detail)) || 'unknown error') };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
